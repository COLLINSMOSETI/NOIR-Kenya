# Copy this file to .env and fill in your real values before running the server.

# ---- Server ----
PORT=4000
# Comma separated list of origins allowed to call this API (your frontend URL(s)).
# Comma-separated Vercel URL(s), plus local development URLs if needed.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://your-store.vercel.app

# ---- Supabase (required on Render) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Admin panel ----
# Password required to log into /admin and use the upload/delete/stock endpoints.
ADMIN_PASSWORD=change-this-password

# ---- WhatsApp ordering ----
# Number that "Order via WhatsApp" messages are sent to, in international format, no plus sign, no spaces.
WHATSAPP_NUMBER=254703502267

# ---- M-Pesa Daraja (Safaricom) STK Push ----
# Get these from https://developer.safaricom.co.ke after creating an app.
# Use the Sandbox values while testing, then switch to production values + MPESA_ENV=production when you go live.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
# Shortcode shown to the customer / used to build the STK password (Sandbox test shortcode is 174379)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey
# Public HTTPS URL Safaricom will call with the payment result.
# In development, run "ngrok http 4000" and put the ngrok URL here, e.g. https://abcd1234.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-public-domain.com/api/mpesa/callback
